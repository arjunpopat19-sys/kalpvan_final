# Copy to .env for local use; on the host set the same names as environment variables.
PORT=5000

# Include the database name (/kalpvan_live) or Atlas puts your data in the default "test" database.
MONGO_URI=mongodb+srv://<user>:<password>@<cluster-host>/kalpvan_live?appName=<app>

# Required: the server refuses to start without it. Use a long random string.
JWT_SECRET=

# Only used when no admin exists yet (first start on an empty database).
ADMIN_EMAIL=admin@kalpvan.com
ADMIN_PASSWORD=
